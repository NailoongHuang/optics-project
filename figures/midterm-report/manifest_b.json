{
  "group_title": "B｜单格点翻转的传播",
  "items": [
    {
      "id": "b01-initial-local-flip",
      "title": "局域单翻转初态",
      "caption": "左图颜色为原点单翻转的概率P，线性色标0至1。右图显示y=0行的纵向自旋期望，原点为-1/2，其余为+1/2。量子化轴为+x；S为无量纲自旋算符。该归一化态有一个确定磁子，不能解释成具有非零横向自旋均值的经典旋转箭头。",
      "group": "b-local-flip",
      "role": "core",
      "parameters": {
        "N": 256,
        "S": 0.5,
        "h": 0,
        "a": 1,
        "Jx": 1,
        "hbar": 1,
        "time_definition": "tau=Jx*t/hbar",
        "eta_definition": "eta=Jy/Jx",
        "initial_state": "one normalized spin flip at (0,0)",
        "boundary": "periodic; edge mass and N=512 comparison checked",
        "method": "FFT exp[-i ((1-cos qx)+eta(1-cos qy))*tau]",
        "tau": 0,
        "eta": 1
      },
      "files": {
        "png": "b-local-flip/b01-initial-local-flip.png",
        "svg": "b-local-flip/b01-initial-local-flip.svg",
        "pdf": "b-local-flip/b01-initial-local-flip.pdf"
      }
    },
    {
      "id": "b02-flat-spectrum",
      "title": "局域初态的均匀波矢权重",
      "caption": "对归一化单格点态作正交归一化二维离散Fourier变换。每个离散波矢的概率均为1/N²，图中绘制N²|A|²以提高可读性。左图为整个第一布里渊区，右图为qy=0截面。局域初态包含整个能带，不能用单个中心波矢及低阶Taylor展开描述其全部传播。",
      "group": "b-local-flip",
      "role": "core",
      "parameters": {
        "N": 256,
        "S": 0.5,
        "h": 0,
        "a": 1,
        "Jx": 1,
        "hbar": 1,
        "time_definition": "tau=Jx*t/hbar",
        "eta_definition": "eta=Jy/Jx",
        "initial_state": "one normalized spin flip at (0,0)",
        "boundary": "periodic; edge mass and N=512 comparison checked",
        "method": "FFT exp[-i ((1-cos qx)+eta(1-cos qy))*tau]"
      },
      "files": {
        "png": "b-local-flip/b02-flat-spectrum.png",
        "svg": "b-local-flip/b02-flat-spectrum.svg",
        "pdf": "b-local-flip/b02-flat-spectrum.pdf"
      }
    },
    {
      "id": "b03-early-neighbor-spreading",
      "title": "早期近邻传播",
      "caption": "四幅图依次为τ=0.25、0.6、1.2、2，固定线性色标0至1，显示中心7×7格点。颜色直接表示单翻转概率，不能逐图归一化解释为同一峰高。哈密顿量的近邻耦合产生概率向外转移；图中为完整FFT计算的局部裁切。",
      "group": "b-local-flip",
      "role": "core",
      "parameters": {
        "N": 256,
        "S": 0.5,
        "h": 0,
        "a": 1,
        "Jx": 1,
        "hbar": 1,
        "time_definition": "tau=Jx*t/hbar",
        "eta_definition": "eta=Jy/Jx",
        "initial_state": "one normalized spin flip at (0,0)",
        "boundary": "periodic; edge mass and N=512 comparison checked",
        "method": "FFT exp[-i ((1-cos qx)+eta(1-cos qy))*tau]",
        "times": [
          0.25,
          0.6,
          1.2,
          2.0
        ],
        "eta": 1,
        "display_crop": 3
      },
      "files": {
        "png": "b-local-flip/b03-early-neighbor-spreading.png",
        "svg": "b-local-flip/b03-early-neighbor-spreading.svg",
        "pdf": "b-local-flip/b03-early-neighbor-spreading.pdf"
      }
    },
    {
      "id": "b04-isotropic-late-snapshots",
      "title": "等方晶格的后期传播",
      "caption": "τ=6、12、24、36的二维翻转概率采用相同空间范围及10^-7至0.1的对数色标。概率低于色标下限不可见，显示边缘不是严格截止。分布向外展开，同时保留相干干涉条纹和方格晶格的四重对称性；因此等方交换的点激发传播并不必然形成圆形波前。",
      "group": "b-local-flip",
      "role": "core",
      "parameters": {
        "N": 256,
        "S": 0.5,
        "h": 0,
        "a": 1,
        "Jx": 1,
        "hbar": 1,
        "time_definition": "tau=Jx*t/hbar",
        "eta_definition": "eta=Jy/Jx",
        "initial_state": "one normalized spin flip at (0,0)",
        "boundary": "periodic; edge mass and N=512 comparison checked",
        "method": "FFT exp[-i ((1-cos qx)+eta(1-cos qy))*tau]",
        "times": [
          6.0,
          12.0,
          24.0,
          36.0
        ],
        "eta": 1,
        "display_crop": 44,
        "color_limits": [
          1e-07,
          0.1
        ]
      },
      "files": {
        "png": "b-local-flip/b04-isotropic-late-snapshots.png",
        "svg": "b-local-flip/b04-isotropic-late-snapshots.svg",
        "pdf": "b-local-flip/b04-isotropic-late-snapshots.pdf"
      }
    },
    {
      "id": "b05-anisotropy-comparison",
      "title": "交换各向异性与一维极限",
      "caption": "固定τ=24与Jx，比较η=0、0.3、1。所有图使用同一空间尺度及10^-7至0.1的对数色标。η=0时y方向无耦合，概率严格停留在y=0行；η=0.3时二维分布沿y较窄；η=1时两个方向对称。这里的各向异性是空间交换参数差异，并未引入自旋空间的易轴或易面项。",
      "group": "b-local-flip",
      "role": "core",
      "parameters": {
        "N": 256,
        "S": 0.5,
        "h": 0,
        "a": 1,
        "Jx": 1,
        "hbar": 1,
        "time_definition": "tau=Jx*t/hbar",
        "eta_definition": "eta=Jy/Jx",
        "initial_state": "one normalized spin flip at (0,0)",
        "boundary": "periodic; edge mass and N=512 comparison checked",
        "method": "FFT exp[-i ((1-cos qx)+eta(1-cos qy))*tau]",
        "tau": 24,
        "etas": [
          0.0,
          0.3,
          1.0
        ],
        "display_crop": 34
      },
      "files": {
        "png": "b-local-flip/b05-anisotropy-comparison.png",
        "svg": "b-local-flip/b05-anisotropy-comparison.svg",
        "pdf": "b-local-flip/b05-anisotropy-comparison.pdf"
      }
    },
    {
      "id": "b06-marginal-probabilities",
      "title": "两个方向的边际概率",
      "caption": "η=0.3时τ=4、12、24的边际概率：左图对y求和，右图对x求和。各曲线对全部格点求和均为1；固定相同横坐标范围和纵轴范围以比较扩展速度。边际概率P_x、P_y与中心截线P_{m,0}、P_{0,n}不同。",
      "group": "b-local-flip",
      "role": "core",
      "parameters": {
        "N": 256,
        "S": 0.5,
        "h": 0,
        "a": 1,
        "Jx": 1,
        "hbar": 1,
        "time_definition": "tau=Jx*t/hbar",
        "eta_definition": "eta=Jy/Jx",
        "initial_state": "one normalized spin flip at (0,0)",
        "boundary": "periodic; edge mass and N=512 comparison checked",
        "method": "FFT exp[-i ((1-cos qx)+eta(1-cos qy))*tau]",
        "eta": 0.3,
        "times": [
          4.0,
          12.0,
          24.0
        ]
      },
      "files": {
        "png": "b-local-flip/b06-marginal-probabilities.png",
        "svg": "b-local-flip/b06-marginal-probabilities.svg",
        "pdf": "b-local-flip/b06-marginal-probabilities.pdf"
      }
    },
