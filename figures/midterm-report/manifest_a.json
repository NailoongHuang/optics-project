    {
      "id": "a04-axial-cuts",
      "title": "方向色散截面",
      "caption": "左图eta=1时沿x和y的截面完全重合（虚线覆盖实线），右图eta=0.35时y方向带宽降为0.7，而x方向带宽仍为2。每条曲线都固定另一分量为零，不能把两条轴向截面当成一般斜向传播的完整色散。",
      "group": "a-dispersion",
      "role": "core",
      "parameters": {
        "S": 0.5,
        "h": 0.0,
        "q": "k*a",
        "energy": "epsilon/Jx",
        "eta": "Jy/Jx",
        "velocity": "hbar*v/(Jx*a)",
        "boundary": "first Brillouin zone",
        "eta_values": [
          1,
          0.35
        ],
        "sample_points": 1001
      },
      "files": {
        "png": "a-dispersion/a04-axial-cuts.png",
        "svg": "a-dispersion/a04-axial-cuts.svg",
        "pdf": "a-dispersion/a04-axial-cuts.pdf"
      },
      "figure_inches": [
        12.8,
        8.0
      ],
      "raster_dpi": 170
    },
    {
      "id": "a05-equal-frequency",
      "title": "等频曲线",
      "caption": "曲线数字是e=epsilon/Jx，依次为0.2、0.6、1.2、2、2.5。小波矢附近，eta=1的等频线近圆，eta=0.35时沿qy方向拉长；高波矢处方格晶格的结构清楚可见。等频线仅约束频率，群速度还取决于曲面的梯度，不能据此宣称局域波包保形。",
      "group": "a-dispersion",
      "role": "core",
      "parameters": {
        "S": 0.5,
        "h": 0.0,
        "q": "k*a",
        "energy": "epsilon/Jx",
        "eta": "Jy/Jx",
        "velocity": "hbar*v/(Jx*a)",
        "boundary": "first Brillouin zone",
        "eta_values": [
          1,
          0.35
        ],
        "levels": [
          0.2,
          0.6,
          1.2,
          2.0,
          2.5
        ],
        "mesh": 501
      },
      "files": {
        "png": "a-dispersion/a05-equal-frequency.png",
        "svg": "a-dispersion/a05-equal-frequency.svg",
        "pdf": "a-dispersion/a05-equal-frequency.pdf"
      },
      "figure_inches": [
        12.8,
        8.0
      ],
      "raster_dpi": 170
    },
    {
      "id": "a06-group-velocity-field",
      "title": "群速度场与等频线法向",
      "caption": "灰线为等能曲线，蓝箭头为u=(sin qx,eta sin qy)，长度按统一比例绘制而未逐点归一化。梯度垂直于等能曲线，并指向能量上升方向。eta=0.35时箭头的y分量减小。该群速度描述窄频谱波包的主导运动；局域翻转包含整个能带，不能用单一箭头概括。",
      "group": "a-dispersion",
      "role": "core",
      "parameters": {
        "S": 0.5,
        "h": 0.0,
        "q": "k*a",
        "energy": "epsilon/Jx",
        "eta": "Jy/Jx",
        "velocity": "hbar*v/(Jx*a)",
        "boundary": "first Brillouin zone",
        "eta_values": [
          1,
          0.35
        ],
        "vector_mesh": 17,
        "arrow_scale": 3.7
      },
      "files": {
        "png": "a-dispersion/a06-group-velocity-field.png",
        "svg": "a-dispersion/a06-group-velocity-field.svg",
        "pdf": "a-dispersion/a06-group-velocity-field.pdf"
      },
      "figure_inches": [
        12.8,
        8.0
      ],
      "raster_dpi": 170
    },
    {
      "id": "a07-slope-and-speed",
      "title": "色散斜率与群速度",
      "caption": "左侧三个彩色点及切线位于qx=-pi/2、0、pi/2；右侧对应点分别给出ux=-1、0、1。原点和布里渊区边界处斜率为零，能量最高并不意味着群速度最大。波包具有有限频谱宽度时，质心速度是其频谱加权平均，中心波矢处的速度是窄带近似。",
      "group": "a-dispersion",
      "role": "core",
      "parameters": {
        "S": 0.5,
        "h": 0.0,
        "q": "k*a",
        "energy": "epsilon/Jx",
        "eta": "Jy/Jx",
        "velocity": "hbar*v/(Jx*a)",
        "boundary": "first Brillouin zone",
        "qy": 0,
        "marked_qx": [
          -1.5707963267948966,
          0,
          1.5707963267948966
        ]
      },
      "files": {
        "png": "a-dispersion/a07-slope-and-speed.png",
        "svg": "a-dispersion/a07-slope-and-speed.svg",
        "pdf": "a-dispersion/a07-slope-and-speed.pdf"
      },
      "figure_inches": [
        12.8,
        8.0
      ],
      "raster_dpi": 170
    },
    {
      "id": "a08-long-wave-approximation",
      "title": "长波二次近似",
      "caption": "两图绘出同一函数的不同范围；左图q<=0.7，右图覆盖0至pi。由cos q=1-q²/2+O(q⁴)得到二次色散。近似只适合小波矢，不能把其无界抛物线及线性增长的群速度延伸到整个晶格能带。",
      "group": "a-dispersion",
      "role": "core",
      "parameters": {
        "S": 0.5,
        "h": 0.0,
        "q": "k*a",
        "energy": "epsilon/Jx",
        "eta": "Jy/Jx",
        "velocity": "hbar*v/(Jx*a)",
        "boundary": "first Brillouin zone",
        "path": "qy=0",
        "zoom_qmax": 0.7,
        "exact_range": [
          0,
          3.141592653589793
        ]
      },
      "files": {
        "png": "a-dispersion/a08-long-wave-approximation.png",
        "svg": "a-dispersion/a08-long-wave-approximation.svg",
        "pdf": "a-dispersion/a08-long-wave-approximation.pdf"
      },
      "figure_inches": [
        12.8,
        8.0
      ],
      "raster_dpi": 170
    },
    {
      "id": "a09-long-wave-error",
      "title": "长波近似的定量误差",
      "caption": "纵轴是轴向能量的相对高估量；曲线在q=0取连续极限0，插图放大小误差区。1%与5%的示例门槛分别对应q约0.345和0.763。门槛仅刻画该轴向能量近似，不等同于波包传播保真度；相位误差还会随时间累积。",
      "group": "a-dispersion",
      "role": "core",
      "parameters": {
        "S": 0.5,
        "h": 0.0,
        "q": "k*a",
        "energy": "epsilon/Jx",
        "eta": "Jy/Jx",
        "velocity": "hbar*v/(Jx*a)",
        "boundary": "first Brillouin zone",
        "tolerance_q": {
          "1": 0.34537557866113044,
          "5": 0.7632996084439329
        },
        "sample_points": 1600
      },
      "files": {
        "png": "a-dispersion/a09-long-wave-error.png",
        "svg": "a-dispersion/a09-long-wave-error.svg",
        "pdf": "a-dispersion/a09-long-wave-error.pdf"
      },
      "figure_inches": [
        12.8,
        8.0
