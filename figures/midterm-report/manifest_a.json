{
  "group_title": "A 色散关系与基本传播原理",
  "items": [
    {
      "id": "a01-lattice",
      "title": "交换晶格与单翻转基底",
      "caption": "25个格点的局部示意中，蓝色实线是横向交换键，橙色虚线是纵向交换键。背景自旋沿+x极化，中心沿-x的箭头代表单翻转基底|0,0>；时间演化后态为这些基底的量子叠加，P_mn=|c_mn|²是测得翻转位于该点的概率。图中箭头示意量子化轴上的取向，不把固定单磁子态的系数解释为经典横向磁矩。eta描述空间方向的交换各向异性。",
      "group": "a-dispersion",
      "role": "core",
      "parameters": {
        "S": 0.5,
        "h": 0.0,
        "q": "k*a",
        "energy": "epsilon/Jx",
        "eta": "Jy/Jx",
        "velocity": "hbar*v/(Jx*a)",
        "boundary": "first Brillouin zone",
        "display_lattice": [
          5,
          5
        ],
        "schematic": true
      },
      "files": {
        "png": "a-dispersion/a01-lattice.png",
        "svg": "a-dispersion/a01-lattice.svg",
        "pdf": "a-dispersion/a01-lattice.pdf"
      },
      "figure_inches": [
        12.8,
        8.0
      ],
      "raster_dpi": 170
    },
    {
      "id": "a02-isotropic-surface",
      "title": "各向同性交换的色散曲面",
      "caption": "在第一布里渊区内绘出eta=1的精确余弦色散。原点能量为零，最大能量为2(1+eta)=4。高度与统一的0至4色标都表示epsilon/Jx。曲面在原点附近近似抛物面；eta<1时沿qy方向起伏较小。三维透视用于概览，方向比较应结合A04的共同坐标截面。",
      "group": "a-dispersion",
      "role": "core",
      "parameters": {
        "S": 0.5,
        "h": 0.0,
        "q": "k*a",
        "energy": "epsilon/Jx",
        "eta": "Jy/Jx",
        "velocity": "hbar*v/(Jx*a)",
        "boundary": "first Brillouin zone",
        "eta_value": 1.0,
        "mesh": 81,
        "color_limits": [
          0,
          4
        ]
      },
      "files": {
        "png": "a-dispersion/a02-isotropic-surface.png",
        "svg": "a-dispersion/a02-isotropic-surface.svg",
        "pdf": "a-dispersion/a02-isotropic-surface.pdf"
      },
      "figure_inches": [
        12.8,
        8.0
      ],
      "raster_dpi": 170
    },
    {
      "id": "a03-anisotropic-surface",
      "title": "各向异性交换改变曲面起伏",
      "caption": "在第一布里渊区内绘出eta=0.35的精确余弦色散。原点能量为零，最大能量为2(1+eta)=2.7。高度与统一的0至4色标都表示epsilon/Jx。曲面在原点附近近似抛物面；eta<1时沿qy方向起伏较小。三维透视用于概览，方向比较应结合A04的共同坐标截面。",
      "group": "a-dispersion",
      "role": "core",
      "parameters": {
